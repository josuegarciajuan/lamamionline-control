# ── Datos de producción ── NO TRACKEAR EN GIT ──
# Los datos viven solo en el working tree. Cualquier git reset --hard,
# stash o checkout los machacaría. El stash de emergencia se crea
# automáticamente, pero la prevención real es no trackearlos.
/data/*
!/data/.gitkeep

# bot-casa: datos vivos de producción (conversaciones, imgs, cancel...).
# Se dejaron de trackear (git rm --cached) para que ningún merge los pise.
/bot-casa/data/

# bot-casa/public/data: runtime del bot (logs, session_memory.ndjson, QR, locks...)
/bot-casa/public/data/

# Test scratch con token hardcodeado (wasap_personal_2026). No trackear.
/_wasap_test.html

# Backups de código (nunca en git; se regeneran localmente)
*.bak

# Directorio template vacío (redundante con data/; DATA_PATH en bootstrap.php apunta a data/)
/DATA_PATH/*

# ── Dependencias ──
node_modules/

# ── Logs ──
*.log
# data/comercial_events.jsonl contiene PII (teléfonos + mensajes reales).
# NO se trackea en git (se eliminó la excepción que lo incluía).

# ── Archivos sensibles ──
/contrato_firmado.php
/ingest_config.php

# ── Backups locales ──
/data_backup_*/

# ── Python cache ──
__pycache__/

# ── Archivos de sistema ──
.DS_Store
Thumbs.db
