{
    "name": "wasapbot/php-bot",
    "description": "WhatsApp bot PHP translation from n8n workflow — Citas business automation",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WasapBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WasapBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse src/ --level=8",
        "test": "phpunit tests/",
        "panel": "php -S localhost:8080 -t public/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
