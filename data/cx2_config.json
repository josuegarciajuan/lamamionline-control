{
  "_doc": "Configuración CX2 — modelo de interés real para bot comercial. Alimenta prompts, clasificación, scoring y escalado.",
  "contract_version": "cx2-f8-v1",
  "scoring_model_version": "1.0.0",
  "signal_weight_catalog_version": "1.0.0",
  "escalation_policy_version": "1.0.0",

  "interest_states": {
    "_doc": "CX2-F1: estados canónicos de interés por conversación",
    "canonical_set": ["sin_datos", "frio", "templado", "caliente", "descartado"],
    "transitions": {
      "sin_datos": ["frio", "templado", "caliente", "descartado"],
      "frio": ["templado", "caliente", "descartado", "frio"],
      "templado": ["frio", "caliente", "descartado", "templado"],
      "caliente": ["templado", "descartado", "caliente"],
      "descartado": ["descartado"]
    },
    "score_range": [0, 100],
    "score_bands": {
      "bajo": [0, 49],
      "medio": [50, 74],
      "alto": [75, 100]
    }
  },

  "signals": {
    "_doc": "CX2-F2: catálogo de señales por canal (WhatsApp v1). Cada señal tiene tipo, clase, peso base y condiciones de detección.",
    "taxonomy": ["positiva", "neutra", "negativa", "bloqueo"],
    "precedence": ["bloqueo", "negativa", "positiva", "neutra"],
    "canal": "whatsapp",
    "catalog": {
      "wa.intent_buy_explicit": {
        "class": "positiva", "weight_base": 24, "confidence_min": 0.70,
        "triggers": ["lo quiero", "me lo quedo", "cuando puedo ir", "pasame direccion", "voy", "quiero ir", "cita", "reservar", "cuando tienes hueco", "estoy interesada", "donde estais", "precio y horario"]
      },
      "wa.intent_price_request": {
        "class": "positiva", "weight_base": 14, "confidence_min": 0.60,
        "triggers": ["precio", "cuanto", "tarifa", "cuesta", "vale", "cuanto es", "que precio", "cuanto cuesta", "precios"]
      },
      "wa.intent_availability_request": {
        "class": "positiva", "weight_base": 12, "confidence_min": 0.55,
        "triggers": ["tienes sitio", "hay hueco", "cuando", "disponible", "horario", "que dias", "abierto", "plaza libre"]
      },
      "wa.intent_followup_accept": {
        "class": "positiva", "weight_base": 10, "confidence_min": 0.50,
        "triggers": ["vale", "ok", "de acuerdo", "perfecto", "genial", "me gusta", "suena bien", "si", "entiendo", "correcto"]
      },
      "wa.reply_fast": {
        "class": "positiva", "weight_base": 6, "confidence_min": 0.40,
        "triggers": ["__reply_in_under_5min__"]
      },
      "wa.question_generic": {
        "class": "neutra", "weight_base": 2, "confidence_min": 0.30,
        "triggers": ["como funciona", "que es", "info", "informacion", "me cuentas", "explicame", "cuentame", "dime"]
      },
      "wa.message_ack": {
        "class": "neutra", "weight_base": 1, "confidence_min": 0.20,
        "triggers": ["ok", "ya", "vale", "gracias", "👍"]
      },
      "wa.silence_timeout_soft": {
        "class": "neutra", "weight_base": -6, "confidence_min": 0.60,
        "triggers": ["__no_reply_in_24h__"]
      },
      "wa.intent_postpone": {
        "class": "neutra", "weight_base": -4, "confidence_min": 0.50,
        "triggers": ["luego", "mas tarde", "otro dia", "la semana que viene", "cuando pueda", "ya te digo", "me lo pienso", "estoy mirando"]
      },
      "wa.price_objection": {
        "class": "negativa", "weight_base": -10, "confidence_min": 0.55,
        "triggers": ["caro", "mucho", "demasiado", "no llego", "es mucho", "no me alcanza", "muy caro"]
      },
      "wa.competitor_mention": {
        "class": "negativa", "weight_base": -8, "confidence_min": 0.45,
        "triggers": ["en otro sitio", "otra casa", "el otro", "mas barato en", "alli", "competencia"]
      },
      "wa.intent_not_interested": {
        "class": "negativa", "weight_base": -24, "confidence_min": 0.70,
        "triggers": ["no interesa", "no gracias", "paso", "no estoy interesada", "dejalo", "no me interesa", "no quiero", "no gracias adios"]
      },
      "wa.silence_timeout_hard": {
        "class": "negativa", "weight_base": -16, "confidence_min": 0.75,
        "triggers": ["__no_reply_in_72h__"]
      },
      "wa.block_keyword": {
        "class": "bloqueo", "weight_base": null, "confidence_min": 0.80,
        "triggers": ["__offensive_language__", "__threat__"],
        "effect": "dominancia_forzada: estado=descartado, score=0, escalado=false"
      },
      "wa.opt_out_request": {
        "class": "bloqueo", "weight_base": null, "confidence_min": 0.80,
        "triggers": ["baja", "no me escribas mas", "borrame", "eliminame", "stop", "no mas mensajes", "dejame en paz", "cancelar", "no enviarme nada"],
        "effect": "dominancia_forzada: estado=descartado, score=0, escalado=false"
      },
      "wa.abusive_content": {
        "class": "bloqueo", "weight_base": null, "confidence_min": 0.85,
        "triggers": ["__abuse_detected__"],
        "effect": "dominancia_forzada: estado=descartado, score=0, escalado=false"
      },
      "wa.unknown": {
        "class": "neutra", "weight_base": 0, "confidence_min": 0.10,
        "triggers": ["__fallback_no_match__"]
      }
    }
  },

  "scoring": {
    "_doc": "CX2-F3: motor de scoring inicial. Pesos, factores y fórmula.",
    "base_score": 35,
    "recent_half_life_hours": {
      "positiva": 120,
      "neutra": 72,
      "negativa": 240
    },
    "inactivity_penalty": {
      "trigger_hours": 72,
      "points_per_day": -2,
      "max_penalty": -20
    },
    "confidence_clamp": [0.30, 1.00],
    "hysteresis": {
      "medio_up": 52, "medio_down": 47,
      "alto_up": 78, "alto_down": 72
    },
    "state_to_band_mapping": {
      "frio": "bajo",
      "templado": "medio",
      "caliente": "alto",
      "descartado": "bajo",
      "sin_datos": "bajo"
    }
  },

  "escalation": {
    "_doc": "CX2-F5: reglas de escalado operativo a comercial humano.",
    "routes": {
      "standard_hot_stable": {
        "score_min": 78,
        "state_required": "caliente",
        "explicit_positive_window_h": 24,
        "stability_evals": 2,
        "stability_min_gap_min": 5,
        "stability_window_min": 60
      },
      "fast_track_explicit_buy": {
        "score_min": 90,
        "signal_required": "wa.intent_buy_explicit",
        "signal_window_h": 2,
        "confidence_min": 0.80
      }
    },
    "hard_stops": [
      "estado_interes = descartado",
      "signal_class = bloqueo activa",
      "wa.opt_out_request activa",
      "score_interes < 75"
    ],
    "anti_noise": {
      "cooldown_hours_per_conversation": 24,
      "cooldown_exception_delta_score": 15,
      "dedupe_window_min": 30,
      "contradiction_guard_min": 120
    }
  },

  "panel_integration": {
    "_doc": "CX2-F6: integración en panel comercial.",
    "allowed_actions": ["confirmar_handoff", "corregir_clasificacion", "reabrir_revision"],
    "priority_rules": {
      "alta": "escalado_operativo_candidato=true && sin bloqueo activo",
      "media": "score_band=alto sin candidato",
      "normal": "resto de casos"
    },
    "security_requirements": [
      "autorizacion contextual por rol+accion+recurso",
      "MFA step-up para overrides criticos",
      "separacion de funciones (4-eyes) en overrides criticos",
      "audit append-only con hash encadenado",
      "idempotency_key obligatoria en cada accion mutante"
    ]
  },

  "calibration": {
    "_doc": "CX2-F7: calibracion periodica y guardrails de riesgo.",
    "cycles": {
      "weekly_operational": {"cadence": "7d", "offset_utc": "Monday 00:00"},
      "monthly_calibration": {"cadence": "4_weeks"},
      "quarterly_governance": {"cadence": "3_months"}
    },
    "guardrails": {
      "fp_rate": {"target": 0.12, "warning": 0.18, "breach": ">0.18"},
      "over_escalation_rate": {"target": 0.20, "breach": ">0.25"},
      "blocking_incidents": {"target": 0, "breach": ">0"}
    },
    "version_decisions": ["promote", "hold", "rollback", "discard"],
    "promote_requires": "2 ciclos semanales consecutivos en ok"
  },

  "acceptance": {
    "_doc": "CX2-F8: criterios de aceptacion y cierre.",
    "business_metrics": {
      "escalation_precision": {"target": 0.70, "reject": 0.50},
      "hot_lead_recall": {"target": 0.60},
      "time_to_handoff_median_min": {"target": 120},
      "perceived_over_escalation": {"target": 0.15},
      "blocking_incidents": {"target": 0, "breach_on_positive": true}
    },
    "operational_metrics": {
      "doc_consistency_score": {"target": 1.0},
      "audit_trail_completeness": {"target": 1.0},
      "decision_reproducibility": {"target": 1.0},
      "phase3_readiness": {"target": true}
    },
    "approval": {
      "type": "dual_signature",
      "required_roles": ["comercial", "arquitectura"],
      "checklist_items": 30,
      "manifest_file": "data/cx2_closure_manifest.json"
    }
  }
}
